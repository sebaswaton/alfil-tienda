DATABASE_URL=postgresql+psycopg://alfil:change-this-postgres-password@localhost:5432/alfil_tienda
FRONTEND_ORIGIN=http://localhost:5173
# Para varios dominios (por ejemplo Pages y localhost), separados por coma:
# FRONTEND_ORIGINS=https://alfil-tienda.pages.dev,http://localhost:5173
APP_ENV=development
ENABLE_API_DOCS=true

# Backend de almacenamiento de archivos: "minio" (VM/Docker) o "local" (cPanel)
STORAGE_BACKEND=minio

# MinIO (archivos privados del catálogo) — solo si STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-this-minio-user
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET=alfil-catalog
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false

# Cloudflare R2 es compatible con la API S3 usada por MinIO:
# MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# MINIO_PUBLIC_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# MINIO_ACCESS_KEY=<r2-access-key-id>
# MINIO_SECRET_KEY=<r2-secret-access-key>
# MINIO_BUCKET=alfil-catalog-demo
# MINIO_REGION=auto
# MINIO_SECURE=true
# MINIO_PUBLIC_SECURE=true

# Disco local (cPanel) — solo si STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=/home/cpaneluser/alfil-media
MEDIA_SIGNING_SECRET=change-this-media-signing-secret
MEDIA_URL_PREFIX=/api/media

# Compartida por ambos backends: horas de validez del enlace firmado
MEDIA_URL_EXPIRY_HOURS=4

# Obligatoria para POST /api/products/{slug}/media
MEDIA_ADMIN_API_KEY=change-this-upload-key

# Primer usuario del panel /admin. Solo se crea si aún no existen usuarios.
# Después del primer arranque, retira ADMIN_INITIAL_PASSWORD del entorno.
ADMIN_INITIAL_USERNAME=administrador
ADMIN_INITIAL_PASSWORD=change-this-password-8-chars-minimum
ADMIN_INITIAL_FULL_NAME=Administrador de catálogo
