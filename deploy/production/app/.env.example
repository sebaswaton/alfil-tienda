# Images generated by the GitHub Actions workflow. Use an immutable release tag.
GHCR_OWNER=sebaswaton
APP_VERSION=v1.0.0
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Public catalog URL and local diagnostic port on the application VM.
PUBLIC_ORIGIN=https://tienda.example.com
FRONTEND_HOST_PORT=8080

# Private address of the data VM. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://alfil:change-this-postgres-password@10.0.0.20:5432/alfil_tienda

# Private endpoint used by FastAPI and public hostname used in signed media URLs.
MINIO_INTERNAL_ENDPOINT=10.0.0.20:9000
MINIO_PUBLIC_ENDPOINT=media.example.com
MINIO_APP_ACCESS_KEY=alfil-catalog-app
MINIO_APP_SECRET_KEY=change-this-minio-application-secret
MINIO_BUCKET=alfil-catalog
MINIO_REGION=us-east-1
MEDIA_URL_EXPIRY_HOURS=4
MEDIA_ADMIN_API_KEY=change-this-media-administration-key

# Token from a remotely managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=change-this-cloudflare-tunnel-token
