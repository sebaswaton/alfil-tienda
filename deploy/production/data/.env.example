# Bind services only to the private vSphere address of the data VM.
DATA_BIND_IP=10.0.0.20
MINIO_CONSOLE_BIND_IP=127.0.0.1

# Pin these images to tested release tags or digests before going live.
POSTGRES_IMAGE=postgres:16-alpine
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest

POSTGRES_USER=alfil
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=alfil_tienda
POSTGRES_DATA_DIR=/srv/alfil/postgres

MINIO_ROOT_USER=alfil-storage-admin
MINIO_ROOT_PASSWORD=change-this-minio-root-password
MINIO_APP_ACCESS_KEY=alfil-catalog-app
MINIO_APP_SECRET_KEY=change-this-minio-application-secret
MINIO_BUCKET=alfil-catalog
MINIO_DATA_DIR=/srv/alfil/minio
